# From https://app.nansen.ai/api — leave empty to run the visual demo tide.
# Calls stay off until NANSEN_ENABLED=1, so a saved key is not spent by accident.
NANSEN_ENABLED=
NANSEN_API_KEY=nsn_265601b9954bc03d34e7afe22c6dc2c2

# One token-screener call covers up to 5 chains.
NANSEN_CHAINS=ethereum,base,robinhood

# Board polls only. Role checks are extra and happen once per wallet.
# 1500 ≈ one cheap call a minute, about 1000 calls in the first day.
# Raise toward 6000 only if the credit balance can take a full sweep every minute.
NANSEN_DAILY_CALL_BUDGET=1500
NANSEN_POLL_SECONDS=60

# Chains used once, when a wallet first enters. Each extra chain costs more credits.
NANSEN_PROFILE_CHAINS=ethereum

# Optional. If empty, a local attestation key is created in data/server-wallet.json.
# This key only signs receipts. It never sends transactions and should hold no funds.
SERVER_WALLET_PRIVATE_KEY=

# Not required for sign-in. OAuth 2.0 Client ID and Client Secret are enough.
# TWITTER_BEARER_TOKEN=

# X user login. From https://developer.x.com — a Web App with OAuth 2.0.
# Enable User authentication and the users.read and tweet.read scopes.
# Callback URL locally: http://localhost:3000/api/auth/x/callback
# Callback URL on Vercel: https://aqualians.vercel.app/api/auth/x/callback
X_CLIENT_ID=OEE4TlhOU2F3cGo5MDVUZThZMmg6MTpjaQ
X_CLIENT_SECRET=z4KdGH7h7X2qbOwfwqPvKkKX4edp8AGMVdcJteOMvsHJ24w32t
# On Vercel set this to the production callback. Locally, leave it unset.
# X_CALLBACK_URL=https://aqualians.vercel.app/api/auth/x/callback

# Optional gate for /api/cron. If empty, the route stays open (the tick is idempotent).
CRON_SECRET=

# Supabase project. Service role stays on the server. Never put it in client code.
SUPABASE_URL=https://yerprvlkovzrphwfrwbb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
